# Copier en `tools/.env` (ignoré par git) pour ne plus avoir à exporter ces
# variables à chaque terminal. Une variable déjà présente dans l'environnement
# l'emporte sur ce fichier : la CI n'est jamais affectée.

# Lecture des alertes Dependabot (npm run deps:index) : OBLIGATOIRE, cet
# endpoint n'a pas de lecture anonyme, même sur un dépôt public. Le jeton du
# GitHub CLI suffit -> `gh auth token`.
# Pour `npm run dora` il reste FACULTATIF : il ne fait que relever la limite de
# 60 requêtes/h de l'API anonyme.
GITHUB_TOKEN=

# Cibles par défaut si on ne surcharge pas (valeurs indicatives)
#ELASTICSEARCH_URL=http://localhost:9200
#KIBANA_URL=http://localhost:5601
#DORA_REPO=EnhydraV/ocr-jsld-p7
#VULNS_REPO=EnhydraV/ocr-jsld-p7
